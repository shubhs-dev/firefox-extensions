{
  "manifest_version": 3,
  "name": "Video Helper",
  "version": "1.1.0",
  "description": "Copies the page URL plus the text of a configurable element to the clipboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-helper@shubhs-dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/shubhs-dev/firefox-extensions/main/updates.json"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "menus",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "defaults.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Copy URL + title",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
